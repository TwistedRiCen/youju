{
  "name": "youju",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @youju/web --filter @youju/api dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:ai-contract": "vitest run packages/ai-core/tests",
    "check:forbidden-content": "tsx scripts/check-forbidden-content.ts",
    "validate:fixtures": "tsx scripts/validate-fixtures.ts",
    "validate:public-demo": "tsx scripts/validate-public-demo.ts",
    "eval:golden-case": "tsx scripts/evaluate-ai-golden-case.ts",
    "build": "pnpm -r --if-present build",
    "e2e": "playwright test",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm validate:fixtures && pnpm build && pnpm e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "^1.0.0",
    "@sinclair/typebox": "^0.34.0",
    "@types/node": "^24.0.0",
    "@youju/ai-core": "workspace:*",
    "@youju/document-export": "workspace:*",
    "@youju/domain": "workspace:*",
    "@youju/rule-engine": "workspace:*",
    "@youju/test-support": "workspace:*",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "fflate": "0.8.3",
    "globals": "^16.0.0",
    "pdfjs-dist": "6.2.108",
    "pdf-lib": "1.17.1",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "overrides": {
      "@rolldown/binding-wasm32-wasi>@napi-rs/wasm-runtime": "1.1.6"
    }
  }
}
